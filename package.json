{
  "name": "mcp-adoption-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "init": "tsx scripts/initialize-dashboard.ts",
    "dev": "concurrently -k \"vite\" \"tsx watch src/server/start-server.ts\"",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/start-server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "smoke": "npm run build && tsx tests/browser-smoke.test.ts",
    "smoke:built": "tsx tests/browser-smoke.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "hooks:install": "git config core.hooksPath .githooks",
    "lint": "eslint .",
    "lint:dead-code": "knip",
    "check": "npm run format:check && npm run lint && npm run lint:dead-code && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "d3": "7.9.0",
    "d3-sankey": "0.12.3",
    "express": "5.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/d3": "7.4.3",
    "@types/d3-sankey": "0.12.5",
    "@types/express": "5.0.6",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "concurrently": "9.2.4",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "jsdom": "27.4.0",
    "knip": "6.37.0",
    "prettier": "3.9.8",
    "read-excel-file": "9.3.10",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "4.1.11"
  },
  "description": "Self-hosted dashboard for exploring Cursor enterprise MCP adoption.",
  "license": "MIT",
  "packageManager": "npm@11.13.0"
}
