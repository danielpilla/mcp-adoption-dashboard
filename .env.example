# Run `npm run init` to securely create .env, then add optional values below.
# The Node dashboard loads .env automatically.
# Do NOT commit .env to git.

# Required for the dashboard. `npm run init` writes a Team Admin API key here.
CURSOR_API_KEY=replace-with-team-admin-key

# Optional display name shown prominently in the dashboard. Cursor's team
# endpoints expose the team ID but not its display name.
CURSOR_TEAM_NAME=Example Team

# Browser-facing Vite UI port used by `npm run dev`.
PORT=5173

# Node API port in development and app port for `npm start` and Docker.
SERVER_PORT=4173

# Interface to bind. Defaults to 127.0.0.1. No route is authenticated, so only
# widen this behind an authenticating reverse proxy.
# BIND_HOST=127.0.0.1

# Required acknowledgement for any non-loopback BIND_HOST. This does not add
# authentication; it only prevents accidental network exposure.
# ALLOW_UNAUTHENTICATED_NETWORK=1

# Optional comma-separated organization-specific MCP labels to classify as
# internal. Cursor-managed MCPs are classified automatically.
# INTERNAL_MCP_SERVERS=example-internal-mcp,another-internal-mcp

# Optional process-safety limits. Defaults are intentionally high and reject
# oversized upstream datasets with sanitized errors instead of risking OOM.
# MAX_MCP_RESPONSE_BYTES=134217728
# MAX_DIRECTORY_GROUPS=10000
# MAX_GROUP_MEMBERSHIPS=250000
# MAX_ENRICHED_GROUP_ASSIGNMENTS=250000

# Optional browser-smoke controls; these are not application configuration.
# CHROME_PATH=
# SMOKE_TEST_DATE=2026-01-15
