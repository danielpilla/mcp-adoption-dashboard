# Run `npm run init` to securely create .env, then add optional values below.
# The Node dashboard loads .env automatically.
# Do NOT commit .env to git.

# Required for the dashboard. `npm run init` writes a Team Admin API key here.
CURSOR_API_KEY=replace-with-team-admin-key

# Optional display name shown prominently in the dashboard. Cursor's team
# endpoints expose the team ID but not its display name.
CURSOR_TEAM_NAME=Example Team

# Browser-facing Vite UI port used by `npm run dev`.
PORT=5173

# Node API port in development and app port for `npm start` and Docker.
SERVER_PORT=4173

# Interface to bind. Defaults to 127.0.0.1. No route is authenticated, so only
# widen this behind an authenticating reverse proxy.
# BIND_HOST=127.0.0.1

# Required acknowledgement for any non-loopback BIND_HOST. This does not add
# authentication; it only prevents accidental network exposure.
# ALLOW_UNAUTHENTICATED_NETWORK=1

# Optional comma-separated organization-specific MCP labels to classify as
# internal. Cursor-managed MCPs are classified automatically.
# INTERNAL_MCP_SERVERS=example-internal-mcp,another-internal-mcp

# Optional caps. Defaults are high enough that they are not reached in normal
# use; set a lower value to bound memory, disk, or request time. When a cap is
# reached, the dashboard shows the data loaded so far (newest days first) with
# a notice naming the setting to raise.
# Activity rows processed for one date range, including zero-usage rows.
# MAX_MCP_RECORDS=100000000
# Serialized size of the activity rows in one result.
# MAX_MCP_RESPONSE_BYTES=25600000000
# Size of one Cursor API response page.
# MAX_API_PAGE_BYTES=67108864
# Directory groups and group memberships loaded from Cursor.
# MAX_DIRECTORY_GROUPS=1000000
# MAX_GROUP_MEMBERSHIPS=100000000
# Group names attached to activity rows in one result; newest rows keep groups.
# MAX_ENRICHED_GROUP_ASSIGNMENTS=1000000000
# Activity rows held across settled results in the 12-hour result cache.
# MAX_CACHED_RECORDS=100000000

# Optional timeouts in milliseconds (at most 2147483647).
# Single request that validates an API key.
# VALIDATION_TIMEOUT_MS=300000
# Loading one date range; days loaded before it passes are shown.
# ANALYTICS_TIMEOUT_MS=7200000
# Background directory load; groups loaded before it passes are kept.
# DIRECTORY_LOAD_TIMEOUT_MS=86400000

# Optional per-day activity cache. Completed days are stored on disk so later
# loads fetch only uncached days. Changing the API key clears the cache.
# MCP_CACHE_DIR=.cache/mcp-activity
# Total size of cached day files; the oldest days are evicted first.
# MCP_CACHE_MAX_BYTES=25600000000
# Days before today that are always refetched; today is always refetched.
# MCP_CACHE_REFETCH_DAYS=2

# Optional browser-smoke controls; these are not application configuration.
# CHROME_PATH=
# SMOKE_TEST_DATE=2026-01-15
